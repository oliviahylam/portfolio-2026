---
import { site, type Lens } from '../data/site';
interface Props { lens: Lens }
const { lens } = Astro.props;
const { intro, introReverse, start, end, screens } = site.desk;
const pos = (r: { left: number; top: number; width: number; height: number }) =>
  `left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`;
const order: Lens[] = ['brand', 'product'];
const href = (l: Lens) => (l === 'brand' ? '/?lens=brand#work-brand' : '/#work');
---
<div class="desk" data-desk data-lens-owner={lens}>
  <div class="desk__frame" data-desk-stage>
    <img class="desk__media desk__still" src={start} alt="An illustration of me working at my desk, with a monitor reading “creative and editorial” and a laptop reading “digital product and AI”" width="1200" height="1200" />
    {intro && <video class="desk__media desk__vid desk__vid--fwd is-on" src={intro} poster={start} muted playsinline preload="auto" aria-hidden="true" data-desk-fwd />}
    {introReverse && <video class="desk__media desk__vid desk__vid--rev" src={introReverse} poster={end} muted playsinline preload="auto" aria-hidden="true" data-desk-rev />}
    <span class="desk__hint mono" aria-hidden="true">Click to step in</span>
    {order.map((l) => (
      <a class={`desk__screen desk__screen--${l}`} href={href(l)} data-desk-go={l} style={pos(screens[l])} tabindex="-1">
        <span class="desk__label">{screens[l].label} →</span>
      </a>
    ))}
  </div>
  <button type="button" class="desk__toggle mono" data-desk-toggle aria-pressed="false">↘ Step into my desk</button>
  <div class="desk__mobile" aria-label="Choose a side of my work">
    {order.map((l) => <a class="chip" href={href(l)} data-desk-go={l}>{screens[l].label} →</a>)}
  </div>
</div>
