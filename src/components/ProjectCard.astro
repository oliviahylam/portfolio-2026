---
import { Image } from 'astro:assets';
import type { Project } from '../lib';
import type { Lens } from '../data/site';
import Tools from './Tools.astro';

interface Props { project: Project; index: number; lens: Lens }
const { project, index, lens } = Astro.props;
const num = lens === 'brand' ? `${String(index).padStart(3, '0')} —` : `${String(index).padStart(2, '0')} ·`;
const d = project.data;
const skills = d.skills.length ? d.skills : d.tags;
const soon = d.comingSoon;
const Tag = soon ? 'div' : 'a';
---
<Tag class:list={['card', { 'card--soon': soon }]} href={soon ? undefined : `/work/${project.id}`} aria-disabled={soon ? 'true' : undefined} style={`view-transition-name:card-${project.id}`}>
  <div class="card__media">
    {d.coverVideo ? (
      <video src={d.coverVideo} autoplay muted loop playsinline aria-hidden="true" />
    ) : d.cover ? (
      <Image src={d.cover} alt="" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading={index <= 2 ? 'eager' : 'lazy'} />
    ) : (
      <span class="card__placeholder mono muted">{d.coverNote ?? '[ cover image ]'}</span>
    )}
    {soon ? <span class="card__soon mono">Coming soon</span> : <span class="card__cta">{d.template === 'editorial' ? 'View project' : 'View case study'} <span aria-hidden="true">›</span></span>}
  </div>
  <div class="card__body">
    <div class="card__main">
      <span class="mono muted">{num} {d.category} · {d.year}</span>
      <h3 class="card__title">{d.title}</h3>
      <p class="card__summary">{d.summary}</p>
    </div>
    <div class="card__side">
      <Tools tools={d.tools} />
      {skills.length > 0 && <div class="tags">{skills.map((s) => <span class="tag">{s}</span>)}</div>}
    </div>
  </div>
</Tag>
