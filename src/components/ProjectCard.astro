---
import { Image } from 'astro:assets';
import type { Project } from '../lib';
import type { Lens } from '../data/site';
import Tools from './Tools.astro';

interface Props { project: Project; index: number; lens: Lens }
const { project, index } = Astro.props;
const d = project.data;
const skills = d.skills.length ? d.skills : d.tags;
---
<a class="card" href={`/work/${project.id}`} style={`view-transition-name:card-${project.id}`}>
  <div class="card__media">
    {d.coverVideo ? (
      <video src={d.coverVideo} autoplay muted loop playsinline aria-hidden="true" />
    ) : d.cover ? (
      <Image src={d.cover} alt="" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 50vw, 100vw" loading={index <= 2 ? 'eager' : 'lazy'} />
    ) : (
      <span class="card__placeholder mono muted">{d.coverNote ?? '[ cover image ]'}</span>
    )}
    <span class="card__cta">{d.template === 'editorial' ? 'View project' : 'View case study'} <span aria-hidden="true">›</span></span>
  </div>
  <div class="card__body">
    <div class="card__side">
      {skills.length > 0 && <div class="tags">{skills.map((s) => <span class="tag">{s}</span>)}</div>}
      <Tools tools={d.tools} />
    </div>
    <div class="card__main">
      <h3 class="card__title">{d.title}</h3>
      <p class="card__summary">{d.summary}</p>
    </div>
  </div>
</a>
