---
import { Image } from 'astro:assets';
import type { Project } from '../lib';
import type { Lens } from '../data/site';

interface Props { project: Project; index: number; lens: Lens; featured?: boolean }
const { project, index, lens, featured = false } = Astro.props;
const d = project.data;
const num = lens === 'brand' ? `${String(index).padStart(3, '0')} —` : `${String(index).padStart(2, '0')} ·`;
const meta = `${num} ${d.category} · ${d.year}`;
const href = `/work/${project.id}`;
const vt = `card-${project.id}`;
---
<a class:list={['card', { featured }]} href={href} style={`view-transition-name:${vt}`}>
  <div class="card__media">
    {d.coverVideo ? (
      <video src={d.coverVideo} autoplay muted loop playsinline aria-hidden="true" />
    ) : d.cover ? (
      <Image src={d.cover} alt="" widths={featured ? [800, 1300, 1800] : [600, 900, 1300]} sizes={featured ? '(min-width: 1000px) 66vw, 100vw' : '(min-width: 1000px) 50vw, 100vw'} loading={featured ? 'eager' : 'lazy'} />
    ) : (
      <span class="card__placeholder mono muted">{d.coverNote ?? '[ cover image ]'}</span>
    )}
  </div>
  <div class="card__body">
    <span class="mono muted">{meta}</span>
    <h3 class="card__title">{d.title}</h3>
    <p class="card__summary">{d.summary}</p>
    {featured && <span class="card__cta">{d.template === 'editorial' ? 'See the project →' : 'Read case study →'}</span>}
  </div>
</a>
