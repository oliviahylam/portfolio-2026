---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tools from '../../components/Tools.astro';
import StoryExtras from '../../components/StoryExtras.astro';
import PartTabs from '../../components/PartTabs.astro';
import { getProjects, type Project } from '../../lib';

export async function getStaticPaths() {
  const all = (await getProjects()).filter((p) => !p.data.comingSoon);
  return all.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const d = project.data;
const lens = d.lens[0];
const { Content } = await render(project);
const siblings = (await getProjects(lens, d.group)).filter((p) => !p.data.comingSoon);
const i = siblings.findIndex((p) => p.id === project.id);
const next = siblings[(i + 1) % siblings.length];
const facts = [
  ['Timeline', d.timeline], ['Role', d.role], ['Team', d.team], ['Client', d.client], ['Industry', d.industry], ['Outcome', d.outcome],
].filter(([, v]) => v) as [string, string][];
const skills = d.skills.length ? d.skills : d.tags;
const editorial = d.template === 'editorial';
const back = lens === 'brand' ? '/?lens=brand#work-brand' : '/#work';
const hasMedia = Boolean(d.cover || d.coverVideo);
---
<Base title={d.title} lens={lens} description={d.summary}>
  {editorial ? (
    <article>
      <header class="ed-head wrap">
        <a class="back mono" href={back}>← Index</a>
        <h1 class="ed-title">{d.title}</h1>
        <div class="meta">
          <div><span class="mono muted">Discipline</span><span>{d.category}</span></div>
          {facts.map(([k, v]) => <div><span class="mono muted">{k}</span><span>{v}</span></div>)}
          <div><span class="mono muted">Year</span><span>{d.year}</span></div>
        </div>
        {(skills.length > 0 || d.tools.length > 0) && (
          <div class="ed-tools">{skills.length > 0 && <div class="chips chips--sm">{skills.map((s) => <span class="chip">{s}</span>)}</div>}<Tools tools={d.tools} /></div>
        )}
      </header>
      <PartTabs parts={d.parts} big />
      <div class="ed-cover">
        {d.coverVideo ? <video src={d.coverVideo} autoplay muted loop playsinline aria-hidden="true" />
          : d.cover ? <Image src={d.cover} alt="" widths={[900, 1600, 2400]} sizes="100vw" loading="eager" /> : <span class="mono muted">{d.coverNote ?? '[ cover image / video ]'}</span>}
      </div>
      <div class="ed-body wrap"><div class="prose"><Content /></div></div>
      <StoryExtras project={project} />
      {next && next.id !== project.id && (
        <a class="next ed-next wrap" href={`/work/${next.id}`}><span class="mono muted">Next</span><span class="next__title">{next.data.title} →</span></a>
      )}
    </article>
  ) : (
    <article class="story">
      <header class="story-hero wrap">
        <a class="back" href={back}>← All work</a>
        <span class="eyebrow">{d.category} · {d.year}</span>
        <h1 class="story-title">{d.title}</h1>
        <p class="story-hook">{d.hook ?? d.summary}</p>
        {d.link && <a class="story-link" href={d.link.url} target="_blank" rel="noopener">{d.link.label} ↗</a>}
      </header>
      <PartTabs parts={d.parts} />
      <div class="wrap">
        <div class:list={['story-cover', { 'story-cover--empty': !hasMedia }]}>
          {d.coverVideo ? <video src={d.coverVideo} autoplay muted loop playsinline aria-hidden="true" />
            : d.cover ? <Image src={d.cover} alt="" widths={[900, 1400, 2000]} sizes="(min-width: 1100px) 1100px, 100vw" loading="eager" /> : <span class="mono muted">{d.coverNote ?? '[ cover image / video ]'}</span>}
        </div>
      </div>

      <section class="wrap" aria-label="Project overview">
        <div class="context-card">
          {(d.context || d.challenge) && (
            <div class="context-card__top">
              {d.context && <div><span class="eyebrow">Why it mattered to me</span><p>{d.context}</p></div>}
              {d.challenge && <div class="challenge"><span class="mono">The question</span><p>{d.challenge}</p></div>}
            </div>
          )}
          <div class="facts">
            {facts.map(([k, v]) => <div><span class="mono muted">{k}</span><span>{v}</span></div>)}
            {skills.length > 0 && <div class="facts__wide"><span class="mono muted">Skills</span><div class="chips chips--sm">{skills.map((s) => <span class="chip">{s}</span>)}</div></div>}
          </div>
          {d.tools.length > 0 && <div class="facts__tools"><span class="mono muted">Tools used</span><Tools tools={d.tools} size="md" /></div>}
        </div>
      </section>

      {d.stats.length > 0 && (
        <section class="stats" aria-label="By the numbers">
          <div class="stats__inner wrap">
            {d.stats.map((s) => <div class="stat"><span class="stat__value">{s.value}</span><span class="stat__label">{s.label}</span>{s.note && <span class="stat__note">{s.note}</span>}</div>)}
          </div>
        </section>
      )}

      <div class="story-body wrap"><div class="prose"><Content /></div></div>
      <StoryExtras project={project} />
      {next && next.id !== project.id && (
        <a class="next wrap" href={`/work/${next.id}`}><span class="mono muted">Next project</span><span style="font-size:clamp(28px,3vw,40px);font-weight:500;letter-spacing:-.02em">{next.data.title} →</span></a>
      )}
    </article>
  )}
</Base>
