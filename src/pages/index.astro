---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Desk from '../components/Desk.astro';
import { site, type Lens } from '../data/site';
import { getProjects } from '../lib';

const lists: Record<Lens, Awaited<ReturnType<typeof getProjects>>> = {
  product: await getProjects('product', 'work'),
  brand: await getProjects('brand', 'work'),
};
const clients: Record<Lens, Awaited<ReturnType<typeof getProjects>>> = {
  product: await getProjects('product', 'client'),
  brand: await getProjects('brand', 'client'),
};
const lenses: Lens[] = ['product', 'brand'];
const isVideo = (s: string) => /\.(mp4|webm|mov)$/i.test(s);
// Pair cards into rows of two; each row shares one height, widths follow each cover's shape.
const rows = <T,>(xs: T[]) => xs.reduce<T[][]>((acc, x, i) => (i % 2 ? acc[acc.length - 1].push(x) : acc.push([x]), acc), []);
---
<Base current="work">
  {lenses.map((lens) => {
    const L = site.lenses[lens];
    const list = lists[lens];
    return (
      <div data-show={lens}>
        <section class="hero wrap" aria-label="Intro">
          <div class="hero__scene"><Desk lens={lens} /></div>
          <div class="hero__bottom">
            <div class="hero__text">
              <span class="mono muted status">{site.status} · Based in {site.location}</span>
              <span class="mono muted">{L.eyebrow}</span>
              <h1 class:list={['display', lens === 'brand' ? 'display--brand' : 'display--product']} set:html={L.headline} />
              <p class="hero__intro">{L.intro}</p>
            </div>
            <a class="mono scroll-cue" href="#work">↓ scroll</a>
          </div>
        </section>

        <section class="intro wrap">
          <div class="intro__label"><span class="mono muted">{lens === 'brand' ? '[ about ]' : '/* about */'}</span></div>
          <div class="intro__body">
            <dl class="intro__cv">
              <div><dt class="mono muted">Currently</dt><dd>{site.currently}</dd></div>
              <div><dt class="mono muted">Previously</dt><dd>{site.previously}</dd></div>
            </dl>
            {L.bio.map((p) => <p>{p}</p>)}
            <div class="chips">{L.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        </section>

        <section id={lens === 'product' ? 'work' : 'work-brand'} class="section wrap wrap--wide" aria-label="Selected work">
          <div class="section__head">
            <h2 class={lens === 'brand' ? 'serif-em' : 'mono'} set:html={L.workTitle} />
            <span class="mono muted">{L.label} · {String(list.length).padStart(2, '0')}</span>
          </div>
          <div class="rows">
            {rows(list).map((row, r) => (
              <div class="row">
                {row.map((p, i) => <ProjectCard project={p} index={r * 2 + i + 1} lens={lens} />)}
                {row.length === 1 && <div class="row__spacer" aria-hidden="true" />}
              </div>
            ))}
          </div>
        </section>

        {clients[lens].length > 0 && (
          <section class="section wrap wrap--wide" aria-label="Client work">
            <div class="section__head">
              <h2 class={lens === 'brand' ? 'serif-em' : 'mono'} set:html={lens === 'brand' ? 'Client <em>work</em>' : '/* client work · silverside ai */'} />
              <span class="mono muted">Silverside AI · {String(clients[lens].length).padStart(2, '0')}</span>
            </div>
            <div class="rows">
              {rows(clients[lens]).map((row, r) => (
                <div class="row">
                  {row.map((p, i) => <ProjectCard project={p} index={r * 2 + i + 1} lens={lens} />)}
                  {row.length === 1 && <div class="row__spacer" aria-hidden="true" />}
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="section wrap" aria-label="Playground">
          <div class="section__head">
            <h2 class="mono">{L.playgroundTitle}</h2>
            <a href={lens === 'brand' ? '/playground?lens=brand' : '/playground'}>See all experiments →</a>
          </div>
          <div class="tiles">
            {site.playground.slice(0, 4).map((x) => (
              <div class="tile">
                {x.media && (isVideo(x.media) ? <video src={x.media} autoplay muted loop playsinline aria-hidden="true" /> : <img src={x.media} alt="" loading="lazy" />)}
                <span class="mono muted">{x.tool}</span>
              </div>
            ))}
          </div>
        </section>
      </div>
    );
  })}
  <script>
    import '../scripts/desk';
  </script>
</Base>
