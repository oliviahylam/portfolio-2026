---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const isVideo = (s: string) => /\.(mp4|webm|mov)$/i.test(s);
---
<Base title="Playground" current="playground">
  <section class="cs-head wrap">
    <span class="mono muted">Playground</span>
    <h1 class="cs-title">Experiments in code, light, space and motion.</h1>
    <p class="cs-summary">Short and unpolished on purpose. Each one is a question I wanted to answer.</p>
  </section>
  <section class="section wrap">
    <div class="pg-grid">
      {site.playground.map((x) => (
        <div class="pg-item">
          <div class="tile">{x.media && (isVideo(x.media) ? <video src={x.media} autoplay muted loop playsinline aria-hidden="true" /> : <img src={x.media} alt="" loading="lazy" />)}</div>
          <div class="pg-item__head"><h3>{x.title}</h3><span class="mono muted">{x.tool}</span></div>
          <p>{x.note}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
